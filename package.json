  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --coverage",
    "dev:server": "tsx watch src/back-end/index.ts",
    "prepare": "husky",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "lint": "oxlint -c oxlint.config.json .",
    "lint:fix": "oxlint -c oxlint.config.json --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "devmoji": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,html,md,yml,yaml}": "npm run fmt",
    "*.{js,jsx,ts,tsx}": "npm run lint:fix"
  }
}
